# --- App ---
CFO_APP_ENV=local
CFO_DEMO_MODE=true            # true = run on seed CSVs, no DB or Xero required
CFO_LOG_LEVEL=INFO
CFO_SECRET_KEY=change-me-32-bytes-min
CFO_JWT_ALGORITHM=HS256
CFO_JWT_TTL_MIN=60

# --- Database (ignored when CFO_DEMO_MODE=true) ---
CFO_DATABASE_URL=postgresql+psycopg://cfo:cfo@localhost:5432/cfo_agents

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
CFO_CLAUDE_MODEL=claude-sonnet-4-6

# --- Xero OAuth2 ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/api/xero/callback
XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.reports.read accounting.settings

# --- n8n webhooks (optional) ---
N8N_WEBHOOK_BASE=
N8N_WEBHOOK_SECRET=

# --- Approval policy ---
CFO_AUTO_APPROVE_THRESHOLD=0.0  # MVP: never auto-approve. Raise later if desired.
