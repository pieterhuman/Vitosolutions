# Copy to .env and fill in. NEVER commit .env.

# Apollo.io API key (Apollo -> Settings -> Integrations -> API).
# Master key recommended so sequences + enrollment endpoints work.
APOLLO_API_KEY=

# Anthropic API key for reply classification and drafting.
ANTHROPIC_API_KEY=

# Gmail app password for vicky@getunicornclub.com
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Used for IMAP reply polling and human-approved SMTP sends only;
# sequence emails are sent by Apollo through the linked mailbox.
GMAIL_APP_PASSWORD=
